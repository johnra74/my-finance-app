<Window x:Class="MyFinance.App.Views.Dialogs.ReconcileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Title="{Binding Title}"
        Width="820" Height="620"
        MinWidth="680" MinHeight="480"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BalancedBrushConverter x:Key="BalancedBrush" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Statement header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{Binding LastReconciledText}" Style="{StaticResource SecondaryText}"
                               FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0" Width="150">
                    <TextBlock Text="Statement date" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding StatementDate}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Width="150">
                    <TextBlock Text="Ending balance" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource AmountBox}"
                             Text="{Binding StatementBalanceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  Style="{StaticResource DataGridBase}"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <!-- A template column rather than DataGridCheckBoxColumn: the built-in one
                     needs a click to select the row and a second to tick it. -->
                <DataGridTemplateColumn Header="On statement" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsTicked, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Width="100" IsReadOnly="True"
                                    Binding="{Binding Date, StringFormat=d}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Num" Width="70" IsReadOnly="True"
                                    Binding="{Binding Number}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Payee" Width="*" IsReadOnly="True"
                                    Binding="{Binding PayeeName}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Amount" Width="130" IsReadOnly="True"
                                    Binding="{Binding AmountText}"
                                    ElementStyle="{StaticResource GridAmountText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- The tally. The difference reaching zero is the whole point of the screen. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceSunkenBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource LinkButton}"
                        Content="Tick everything" Command="{Binding TickAllCommand}" />
                <Button Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource LinkButton}"
                        Content="Clear all" Command="{Binding UntickAllCommand}" />

                <TextBlock Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding ProgressText}" />

                <StackPanel Grid.Column="3" Margin="0,0,24,0">
                    <TextBlock Text="Starting balance" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding StartingBalanceText}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource NumericFontFamily}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,24,0">
                    <TextBlock Text="Ticked balance" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ClearedBalanceText}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource NumericFontFamily}" />
                </StackPanel>

                <StackPanel Grid.Column="5">
                    <TextBlock Text="Difference" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DifferenceText}" HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               Foreground="{Binding IsBalanced, Converter={StaticResource BalancedBrush}}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Postpone"
                        ToolTip="Close without recording the balance. Ticks are not kept."
                        IsCancel="True" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Finish" Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding IsBalanced}"
                        Command="{Binding FinishCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
