<Window x:Class="MyFinance.App.Views.Dialogs.PriceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Price"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="As of date" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding AsOfDate}" />

        <TextBlock Text="Price per unit" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
