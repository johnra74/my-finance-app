<Window x:Class="MyFinance.App.Views.Dialogs.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        xmlns:controls="clr-namespace:MyFinance.App.Views.Controls"
        Title="{Binding Title}"
        Width="820" Height="640"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
    </Window.Resources>

    <Grid>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleText}" Text="Backups" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Text="{Binding Explanation}" />
        </StackPanel>

        <!-- How they are kept. Saved as they are changed: a Save button here is one more
             thing to forget, and forgetting this one means no backups at all. -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <CheckBox Content="Back up automatically when the book is closed"
                              IsChecked="{Binding Automatic}" />
                    <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                        <TextBlock Text="Keep the newest" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                        <TextBox Width="52" Margin="8,0" TextAlignment="Center"
                                 Text="{Binding KeepText, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="and delete older ones" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <TextBlock Text="Kept in" Style="{StaticResource FieldLabel}" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="{Binding Folder}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Change folder..."
                                Command="{Binding ChooseFolderCommand}" />
                        <Button Style="{StaticResource LinkButton}" Content="Use the default"
                                Margin="16,0,0,0"
                                Command="{Binding UseDefaultFolderCommand}" />
                        <Button Style="{StaticResource LinkButton}" Content="Open folder"
                                Margin="16,0,0,0"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SecondaryText}"
                           Margin="0,0,0,10" Text="{Binding StatusText}" />

                <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Text="Nothing has been backed up yet. Take one now — it takes a moment and there is no way to recover a book without one."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding Selected}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVisibility}}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete this backup"
                                      Command="{Binding PlacementTarget.DataContext.DeleteCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Taken" Width="220"
                                            Binding="{Binding CreatedText}"
                                            ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="File" Width="*"
                                            Binding="{Binding FileName}"
                                            ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="Size" Width="110"
                                            Binding="{Binding SizeText}"
                                            ElementStyle="{StaticResource GridAmountText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Restoring replaces the file this session is reading, so it belongs on the
             opening screen. Saying where beats leaving somebody to hunt for it. -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="{Binding RestoreHint}" />
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                       Style="{StaticResource SecondaryText}" Text="Working..."
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Button Style="{StaticResource SecondaryButton}" Content="Back up to..."
                    Command="{Binding BackUpToCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Back up now" Margin="8,0,0,0"
                    Command="{Binding BackUpNowCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Close" Margin="8,0,0,0"
                    IsCancel="True" IsDefault="True" Command="{Binding DoneCommand}" />
        </StackPanel>
    </Grid>

        <!-- Over everything, so nothing behind it can be clicked while work is running. -->
        <controls:BusyOverlay />
    </Grid>
</Window>
