<Window x:Class="MyFinance.App.Views.Dialogs.SplitEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Title="{Binding Title}"
        Width="720" Height="480"
        MinWidth="600" MinHeight="380"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BalancedBrushConverter x:Key="BalancedBrush" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                   Text="Assign the transaction across as many categories as you need. The lines have to add up to the transaction total before this can be saved." />

        <DataGrid Grid.Row="1"
                  Style="{StaticResource DataGridBase}"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  RowHeight="34">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Category" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="4,2"
                                      BorderThickness="0"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="FullName"
                                      SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Amount" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="4,2"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextAlignment="Right"
                                     FontFamily="{StaticResource NumericFontFamily}"
                                     Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Memo" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Margin="4,2"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                    Content="Add line" Command="{Binding AddRowCommand}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Remove line" Command="{Binding RemoveRowCommand}"
                    CommandParameter="{Binding SelectedRow}" />

            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Assign the rest here"
                    ToolTip="Drop whatever is unassigned onto the selected line"
                    Command="{Binding AssignRemainderCommand}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Transaction" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource NumericFontFamily}" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Assigned" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding AssignedText}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource NumericFontFamily}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Unassigned" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UnassignedText}" HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource NumericFontFamily}"
                               Foreground="{Binding IsBalanced, Converter={StaticResource BalancedBrush}}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                        IsCancel="True" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                        IsDefault="True" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
