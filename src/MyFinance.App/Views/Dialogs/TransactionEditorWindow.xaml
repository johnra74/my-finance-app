<Window x:Class="MyFinance.App.Views.Dialogs.TransactionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="TextToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding Date}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Number or reference" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Payee" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <!-- Editable so a payee that does not exist yet can simply be typed; the service
             creates it on save. -->
        <ComboBox IsEditable="True"
                  IsTextSearchEnabled="True"
                  IsTextSearchCaseSensitive="False"
                  StaysOpenOnEdit="True"
                  ItemsSource="{Binding PayeeNames}"
                  Text="{Binding PayeeName, UpdateSourceTrigger=LostFocus}"
                  LostFocus="OnPayeeLostFocus" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource AmountBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Transfer to or from" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding TransferTargets}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding TransferAccount}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Not a transfer"
                    ToolTip="Clear the transfer account and treat this as ordinary spending"
                    Command="{Binding ClearSplitsCommand}"
                    Click="OnClearTransfer" />
        </Grid>

        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="FullName"
                      SelectedItem="{Binding Category}"
                      IsEnabled="{Binding CanPickCategory}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Split…" Command="{Binding EditSplitsCommand}" />
        </Grid>

        <TextBlock Style="{StaticResource SecondaryText}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,4,0,0"
                   Text="{Binding CategorySummary}" />

        <!--
            Where the recommendation appears. A rule or this payee's usual category has already
            filled the box above and this only says why; a guess from the classifier or from a
            lookalike merchant is offered here instead, and is never applied without the user
            asking for it.
        -->
        <Grid Margin="0,4,0,0"
              Visibility="{Binding SuggestionText, Converter={StaticResource TextToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Text="{Binding SuggestionText}" />

            <Button Grid.Column="1" Margin="10,0,0,0"
                    Style="{StaticResource LinkButton}"
                    Content="Use this"
                    Command="{Binding UseSuggestionCommand}"
                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TextBlock Text="Memo" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox Content="Cleared at the bank" IsChecked="{Binding IsCleared}" />
            <CheckBox Content="Void" IsChecked="{Binding IsVoid}" Margin="20,0,0,0"
                      ToolTip="Keeps the row for the audit trail but contributes nothing to any balance" />
        </StackPanel>

        <TextBlock Style="{StaticResource SecondaryText}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="This item was locked in by a completed balance. Editing it will not change its reconciled state unless you untick it."
                   Visibility="{Binding IsReconciledWarningVisible, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
