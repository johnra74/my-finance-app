<Window x:Class="MyFinance.App.Views.Dialogs.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Title="{Binding Title}"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Payee" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding PayeeName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Account" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Accounts}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedAccount}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Direction" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource AmountBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <CheckBox Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,8"
                      Content="Estimated"
                      ToolTip="The figure varies; the bills list marks these with a tilde"
                      IsChecked="{Binding IsEstimate}" />
        </Grid>

        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <ComboBox ItemsSource="{Binding Categories}"
                  DisplayMemberPath="FullName"
                  SelectedItem="{Binding SelectedCategory}" />

        <TextBlock Text="Memo" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

        <Separator Margin="0,18,0,14" Background="{StaticResource BorderBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="How often" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Frequencies}"
                          DisplayMemberPath="Text"
                          SelectedItem="{Binding SelectedFrequency}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="First due" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding StartDate}" />
            </StackPanel>
        </Grid>

        <!-- Only meaningful for a twice-monthly series, so it appears only for one. -->
        <StackPanel Margin="0,14,0,0"
                    Visibility="{Binding NeedsSecondDay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Second day of the month" Style="{StaticResource FieldLabel}" />
            <TextBox Width="120" HorizontalAlignment="Left"
                     Text="{Binding SecondDayOfMonth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     ToolTip="Leave empty to fall a fortnight after the first" />
        </StackPanel>

        <TextBlock Text="If it lands on a weekend" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <ComboBox ItemsSource="{Binding WeekendShifts}"
                  DisplayMemberPath="Text"
                  SelectedItem="{Binding SelectedWeekendShift}" />

        <TextBlock Text="Ending" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Endings}"
                      DisplayMemberPath="Text"
                      SelectedItem="{Binding SelectedEnding}" />

            <DatePicker Grid.Column="1" Width="150" Margin="8,0,0,0"
                        SelectedDate="{Binding EndDate}"
                        Visibility="{Binding NeedsEndDate, Converter={StaticResource BoolToVisibility}}" />

            <TextBox Grid.Column="1" Width="150" Margin="8,0,0,0"
                     Text="{Binding OccurrenceCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     Visibility="{Binding NeedsOccurrenceCount, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- The dates the pattern actually produces. Reading them back is the only reliable
             way to tell whether a recurrence says what was meant. -->
        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding RecurrenceSummary}" Style="{StaticResource BodyText}" />
                <TextBlock Text="{Binding NextDatesPreview}" Style="{StaticResource SecondaryText}"
                           FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      Content="Enter it automatically"
                      ToolTip="Writes the transaction into the register without asking, when the book is opened"
                      IsChecked="{Binding AutoEnter}" />

            <TextBox Grid.Column="1" Width="50" Margin="12,0,6,0"
                     Text="{Binding DaysAheadToEnter, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}"
                       Text="days ahead" />

            <CheckBox Grid.Column="3" VerticalAlignment="Center"
                      Content="Active" IsChecked="{Binding IsActive}" />
        </Grid>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
