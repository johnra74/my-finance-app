<Window x:Class="MyFinance.App.Views.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720" Height="600"
        MinWidth="560" MinHeight="420"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitleText}" Text="MyFinance" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                       Text="{Binding VersionText}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                       Text="{Binding CopyrightText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Text="{Binding SummaryText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                       TextWrapping="Wrap" Text="{Binding LicenceSummary}" />
        </StackPanel>

        <!--
            Both texts are selectable and scrollable rather than shown as a summary. A notice
            that cannot be copied out is of no use to somebody checking what this executable
            carries, which is the whole reason they are in here.
        -->
        <TabControl Grid.Row="1">
            <TabItem Header="Third-party notices">
                <TextBox Text="{Binding NoticeText, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource SurfaceSunkenBrush}"
                         FontFamily="{StaticResource NumericFontFamily}"
                         FontSize="{StaticResource FontSizeSmall}"
                         Padding="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Licence">
                <TextBox Text="{Binding LicenceText, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="{StaticResource SurfaceSunkenBrush}"
                         FontFamily="{StaticResource NumericFontFamily}"
                         FontSize="{StaticResource FontSizeSmall}"
                         Padding="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Documentation"
                    Command="{Binding OpenHelpCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Close" Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"
                    Command="{Binding DoneCommand}" />
        </StackPanel>
    </Grid>
</Window>
