<Window x:Class="MyFinance.App.Views.Dialogs.BudgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Categories}"
                  DisplayMemberPath="FullName"
                  SelectedItem="{Binding SelectedCategory}"
                  IsEditable="False" />

        <TextBlock Text="Amount for the month" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource SecondaryText}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,4,0,0"
                   Text="Enter it as a positive figure, whether it is money in or money out." />

        <CheckBox Content="Carry anything unspent into next month"
                  IsChecked="{Binding RollsOver}"
                  Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource SecondaryText}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding RolloverHint}" />

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
