<Window x:Class="MyFinance.App.Views.Dialogs.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Under" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <ComboBox ItemsSource="{Binding Parents}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Parent}"
                  IsEditable="False" />
        <TextBlock Style="{StaticResource SecondaryText}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,4,0,0"
                   Text="Leave empty to make this a top-level heading. Categories go two levels deep." />

        <StackPanel Margin="0,14,0,0">
            <CheckBox Content="This is income rather than spending"
                      IsChecked="{Binding IsIncome}"
                      IsEnabled="{Binding CanChooseKind}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Margin="0,4,0,0"
                       Text="A subcategory always takes its heading's side of the books."
                       Visibility="{Binding CanChooseKind, Converter={StaticResource NotBoolToVisibility}}" />
            <CheckBox Content="Tax related" IsChecked="{Binding IsTaxRelated}" Margin="0,10,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
