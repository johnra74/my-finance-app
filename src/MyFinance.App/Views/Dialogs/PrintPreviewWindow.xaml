<Window x:Class="MyFinance.App.Views.Dialogs.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print preview"
        Width="980" Height="760"
        MinWidth="640" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The page count is stated here, before anything can be sent to a printer.
             A twenty-five-year register is thousands of pages and somebody will ask for
             one by accident. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="Summary"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="Warning"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="{StaticResource WarningBrush}"
                       Visibility="Collapsed" />

            <TextBlock Text="Orientation" VerticalAlignment="Center" Margin="24,0,8,0" />
            <ComboBox x:Name="Orientation"
                      Width="120"
                      VerticalAlignment="Center"
                      SelectionChanged="OnOrientationChanged">
                <ComboBoxItem Content="Portrait" IsSelected="True" />
                <ComboBoxItem Content="Landscape" />
            </ComboBox>
        </StackPanel>

        <DocumentViewer x:Name="Viewer"
                        Grid.Row="1"
                        Background="{StaticResource SurfaceAltBrush}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="PrintButton"
                    Content="Print…"
                    MinWidth="120"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnPrint" />
        </StackPanel>
    </Grid>
</Window>
