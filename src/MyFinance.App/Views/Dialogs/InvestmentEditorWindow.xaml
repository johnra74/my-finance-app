<Window x:Class="MyFinance.App.Views.Dialogs.InvestmentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Investment Activity"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Security" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding SecurityOptions}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedSecurity}"
                  IsEditable="False" />

        <TextBlock Text="Activity" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <ComboBox ItemsSource="{Binding Activity, Mode=OneWay}"
                  SelectedItem="{Binding Activity}"
                  IsEditable="False" />

        <TextBlock Text="Date" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <DatePicker SelectedDate="{Binding Date}" />

        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Price per unit" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding PricePerUnitText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Fees" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Style="{StaticResource AmountBox}"
                 Text="{Binding FeesText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Memo" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,14,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                    IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0"
                    IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
