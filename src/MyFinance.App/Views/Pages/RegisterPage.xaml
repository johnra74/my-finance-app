<UserControl x:Class="MyFinance.App.Views.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MyFinance.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MoneyConverter x:Key="Money" />
        <conv:MoneySignBrushConverter x:Key="MoneyBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
    </UserControl.Resources>

    <!-- Keyboard first: entering transactions is a repetitive job and reaching for the
         mouse between each one is what makes bookkeeping feel like a chore. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewTransactionCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteTransactionCommand}"
                    CommandParameter="{Binding SelectedRow}" />
        <KeyBinding Key="Enter"
                    Command="{Binding EditTransactionCommand}"
                    CommandParameter="{Binding SelectedRow}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar and filters -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Content="New" ToolTip="Enter a new transaction (Ctrl+N)"
                    Command="{Binding NewTransactionCommand}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Edit" Command="{Binding EditTransactionCommand}"
                    CommandParameter="{Binding SelectedRow}" />

            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Duplicate" Command="{Binding DuplicateTransactionCommand}"
                    CommandParameter="{Binding SelectedRow}" />

            <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Delete" Command="{Binding DeleteTransactionCommand}"
                    CommandParameter="{Binding SelectedRow}" />

            <Button Grid.Column="4" Margin="8,0,0,0" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"
                    Content="Print…"
                    ToolTip="Print this register as it currently reads, filter and all"
                    Command="{Binding PrintRegisterCommand}" />

            <CheckBox Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0"
                      Content="Needs a category"
                      IsChecked="{Binding UncategorizedOnly}" />

            <ComboBox Grid.Column="6" Width="150" Margin="0,0,8,0"
                      ItemsSource="{Binding Ranges}"
                      DisplayMemberPath="Text"
                      SelectedItem="{Binding SelectedRange}" />

            <TextBox Grid.Column="7" Width="200"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     ToolTip="Search payee, memo, number or amount" />
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Nothing recorded yet" Style="{StaticResource SubtitleText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,12"
                           Text="Enter transactions by hand here, or import a statement once file import arrives. The balance column runs from the account's opening balance." />
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Content="Enter a transaction" Command="{Binding NewTransactionCommand}" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  Style="{StaticResource DataGridBase}"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVisibility}}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding EditTransactionCommand}"
                              CommandParameter="{Binding SelectedRow}" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Num" Width="70"
                                    Binding="{Binding Number}"
                                    ElementStyle="{StaticResource GridCellText}" />

                <DataGridTextColumn Header="Date" Width="100"
                                    Binding="{Binding DateText}"
                                    ElementStyle="{StaticResource GridCellText}" />

                <DataGridTemplateColumn Header="Payee" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,3">
                                <TextBlock Text="{Binding PayeeName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Memo}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Category" Width="1.5*"
                                    Binding="{Binding CategoryText}"
                                    ElementStyle="{StaticResource GridCellText}" />

                <!-- The cleared marker is a button so the column works the way Money's does:
                     one click on the row toggles it. -->
                <DataGridTemplateColumn Header="C" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}"
                                    HorizontalContentAlignment="Center"
                                    Content="{Binding ClearedMark}"
                                    ToolTip="Mark this item cleared or uncleared"
                                    Command="{Binding DataContext.ToggleClearedCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Payment" Width="110"
                                    Binding="{Binding PaymentText}"
                                    ElementStyle="{StaticResource GridAmountText}" />

                <DataGridTextColumn Header="Deposit" Width="110"
                                    Binding="{Binding DepositText}"
                                    ElementStyle="{StaticResource GridAmountText}" />

                <DataGridTemplateColumn Header="Balance" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource GridAmountText}"
                                       Text="{Binding BalanceText}"
                                       Foreground="{Binding Balance, Converter={StaticResource MoneyBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Void rows stay visible for the audit trail but read as struck out. -->
                        <DataTrigger Binding="{Binding IsVoid}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUncategorized}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit…"
                              Command="{Binding PlacementTarget.DataContext.EditTransactionCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Duplicate into today"
                              Command="{Binding PlacementTarget.DataContext.DuplicateTransactionCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Mark cleared or uncleared"
                              Command="{Binding PlacementTarget.DataContext.ToggleClearedCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Void or unvoid"
                              Command="{Binding PlacementTarget.DataContext.ToggleVoidCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Delete…"
                              Command="{Binding PlacementTarget.DataContext.DeleteTransactionCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Footer: the two balances Money shows under a register. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceSunkenBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding CountText}" />

                <Button Grid.Column="1" HorizontalAlignment="Left" Margin="20,0,0,0"
                        Style="{StaticResource LinkButton}"
                        Content="Balance this account…"
                        Command="{Binding ReconcileCommand}" />

                <StackPanel Grid.Column="2" Margin="0,0,28,0">
                    <TextBlock Text="Bank balance" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock FontFamily="{StaticResource NumericFontFamily}"
                               HorizontalAlignment="Right"
                               Text="{Binding ClearedBalanceText}"
                               Foreground="{Binding ClearedBalance, Converter={StaticResource MoneyBrush}}" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Balance" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Text="{Binding CurrentBalanceText}"
                               Foreground="{Binding CurrentBalance, Converter={StaticResource MoneyBrush}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
