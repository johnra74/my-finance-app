<UserControl x:Class="MyFinance.App.Views.Pages.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Content="New category" Command="{Binding NewCommand}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Edit" Command="{Binding EditCommand}"
                    CommandParameter="{Binding Selected}" />

            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Archive" ToolTip="Hide from pickers but keep the history readable"
                    Command="{Binding ToggleArchivedCommand}"
                    CommandParameter="{Binding Selected}" />

            <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="Delete" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding Selected}" />

            <CheckBox Grid.Column="5" VerticalAlignment="Center"
                      Content="Show archived" IsChecked="{Binding ShowArchived}" />
        </Grid>

        <DataGrid Grid.Row="1"
                  Style="{StaticResource DataGridBase}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected}">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding EditCommand}"
                              CommandParameter="{Binding Selected}" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Width="*"
                                    Binding="{Binding FullName}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Kind" Width="110"
                                    Binding="{Binding Kind}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Used by" Width="110"
                                    Binding="{Binding UseCount}"
                                    ElementStyle="{StaticResource GridAmountText}" />
                <!-- One way, and read-only. This grid shows a projection, not an entity:
                     ticking a box here edited a detached copy that was never saved (Tax), or
                     threw outright against a get-only property (Archived). Both values are
                     changed through a service — Tax in the Edit dialog, Archived by the
                     Archive button — as principle 3 requires. DataGridCheckBoxColumn binds
                     two way unless told otherwise, so both have to say so. -->
                <DataGridCheckBoxColumn Header="Tax" Width="60" IsReadOnly="True"
                                        Binding="{Binding Category.IsTaxRelated, Mode=OneWay}" />
                <DataGridCheckBoxColumn Header="Archived" Width="80" IsReadOnly="True"
                                        Binding="{Binding IsArchived, Mode=OneWay}" />
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Headings read heavier than their subcategories, so the flat list
                             still scans as a tree. -->
                        <DataTrigger Binding="{Binding IsParent}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
