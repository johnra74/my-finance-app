<UserControl x:Class="MyFinance.App.Views.Pages.ForecastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MyFinance.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MoneySignBrushConverter x:Key="MoneyBrush" />
        <conv:NullToVisibilityConverter x:Key="TextToVisibility" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Accounts}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedAccount}"
                      ToolTip="Leave empty to project every account together" />

            <ComboBox Grid.Column="1" Width="160" Margin="8,0,0,0"
                      ItemsSource="{Binding Ranges}"
                      DisplayMemberPath="Text"
                      SelectedItem="{Binding SelectedRange}" />
        </Grid>

        <!-- The warning band. Where the line dips below zero is the point of the screen. -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,10" CornerRadius="6"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource NegativeBrush}"
                BorderThickness="1"
                Visibility="{Binding GoesNegative, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Warning}" />
        </Border>

        <DataGrid Grid.Row="2"
                  Style="{StaticResource DataGridBase}"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="160"
                                    Binding="{Binding DateText}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Expected" Width="*"
                                    Binding="{Binding Detail}"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTemplateColumn Header="Change" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource GridAmountText}"
                                       Text="{Binding ChangeText}"
                                       Foreground="{Binding Change, Converter={StaticResource MoneyBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Balance" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource GridAmountText}"
                                       FontWeight="SemiBold"
                                       Text="{Binding BalanceText}"
                                       Foreground="{Binding Balance, Converter={StaticResource MoneyBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNegative}" Value="True">
                            <Setter Property="Background" Value="#FFFDECEA" />
                        </DataTrigger>
                        <!-- Days that have already happened are shown for context but read
                             as history rather than as something still to come. -->
                        <DataTrigger Binding="{Binding IsHistory}" Value="True">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceSunkenBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LowestBalanceText}"
                               Style="{StaticResource SecondaryText}"
                               Visibility="{Binding LowestBalanceText, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Text="Some amounts in this projection are estimates."
                               Visibility="{Binding IncludesEstimates, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                    <TextBlock Text="Starting" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock FontFamily="{StaticResource NumericFontFamily}"
                               HorizontalAlignment="Right"
                               Text="{Binding OpeningBalanceText}"
                               Foreground="{Binding OpeningBalance, Converter={StaticResource MoneyBrush}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Projected" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Right" />
                    <TextBlock FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Text="{Binding ClosingBalanceText}"
                               Foreground="{Binding ClosingBalance, Converter={StaticResource MoneyBrush}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
