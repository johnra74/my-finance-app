<UserControl x:Class="MyFinance.App.Views.Pages.HoldingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MyFinance.App.Converters">

    <UserControl.Resources>
        <conv:MoneyConverter x:Key="Money" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Content="Record activity"
                    Command="{Binding RecordActivityCommand}" />

            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="Set price"
                    Command="{Binding SetPriceCommand}"
                    CommandParameter="{Binding SelectedRow}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                <Run Text="as of " FontSize="11" />
                <Run FontSize="11" />
            </TextBlock>
        </Grid>

        <!-- Holdings DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Holdings}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Style="{StaticResource ListGrid}"
                  ColumnHeaderStyle="{StaticResource ListGridColumnHeader}"
                  CellStyle="{StaticResource ListGridCell}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Security" Binding="{Binding SecurityName}" Width="*" />
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="80" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityText}" Width="100" />
                <DataGridTextColumn Header="Avg cost" Binding="{Binding AverageCostText}" Width="100" />
                <DataGridTextColumn Header="Cost basis" Binding="{Binding CostBasisText}" Width="120" />
                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" />
                <DataGridTextColumn Header="Priced as of" Binding="{Binding PriceDateText}" Width="120" />
                <DataGridTextColumn Header="Status" Binding="{Binding AtCostText}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SeparatorBrush}" Padding="12,12,12,0">
            <TextBlock Text="{Binding PortfolioValueText}" VerticalAlignment="Center" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
