<UserControl x:Class="MyFinance.App.Views.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MyFinance.App.Converters">

    <!--
        Binds straight to whatever BusyViewModel it is dropped in front of, so adding it to a
        screen is one line of XAML and no wiring.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="Not" />
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <!--
        Dims what is working rather than hiding it, so the figures being replaced stay visible
        behind and the window still looks like the one the user was just in.
    -->
    <Grid Background="#B0FFFFFF">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28,22"
                MinWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Progress.Stage}" />

                <ProgressBar Style="{StaticResource ProgressBarBase}"
                             Margin="0,14,0,0"
                             Minimum="0" Maximum="1"
                             Value="{Binding Progress.Fraction, Mode=OneWay}"
                             IsIndeterminate="{Binding Progress.IsDeterminate, Converter={StaticResource Not}}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Counts only when they are real. A percentage nobody can compute is
                         worse than none, because it sets an expectation about the wait. -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding Progress.CountText}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource LinkButton}"
                            Content="Stop"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
