<Window x:Class="MyFinance.App.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyFinance.App.ViewModels"
        xmlns:conv="clr-namespace:MyFinance.App.Converters"
        Icon="/Assets/MyFinance.ico"
        Title="MyFinance"
        Width="880" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
    </Window.Resources>

    <Window.InputBindings>
        <!-- The password and backup questions are asked here, before there is a book to open
             the shell's Help from. -->
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Branding rail -->
        <Border Grid.Column="0" Background="{StaticResource NavBarBrush}">
            <StackPanel Margin="32,44,32,0">
                <TextBlock Text="MyFinance"
                           Foreground="{StaticResource TextInvertedBrush}"
                           FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Your books, encrypted on your own machine."
                           Foreground="#FFB9C6D6"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Welcome -->
        <Grid Grid.Column="1" Margin="40,44,40,32"
              Visibility="{Binding Mode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Welcome}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Open a book" Style="{StaticResource PageTitleText}" />

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Top"
                           Text="No books yet. Create one to get started."
                           Visibility="{Binding RecentBooks.Count, Converter={StaticResource ZeroToVisibility}}" />

                <ListBox ItemsSource="{Binding RecentBooks}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}"
                                    Command="{Binding DataContext.ChooseRecentCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DatabasePath}"
                                               Style="{StaticResource SecondaryText}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <TextBlock Grid.Row="2" Style="{StaticResource ErrorText}"
                       Text="{Binding ErrorMessage}"
                       Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Create a book"
                        Command="{Binding StartCreateCommand}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Open another..."
                        Margin="10,0,0,0"
                        Command="{Binding BrowseForBookCommand}" />
                <!-- Restore lives here because this is the only moment it is safe: no book
                     is open, so nothing is writing into the file about to be replaced. -->
                <Button Style="{StaticResource LinkButton}"
                        Content="Restore from a backup..."
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RestoreFromBackupCommand}" />
                <Button Style="{StaticResource LinkButton}"
                        Content="Help"
                        ToolTip="Creating a book, the password, and the two files (F1)"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding HelpCommand}" />
                <Button Style="{StaticResource LinkButton}"
                        Content="About"
                        ToolTip="Version, licence and what this build is made of"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding AboutCommand}" />
            </StackPanel>
        </Grid>

        <!-- Unlock -->
        <Grid Grid.Column="1" Margin="40,44,40,32"
              Visibility="{Binding Mode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Unlock}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Unlock" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding SelectedBookName}"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,4,0,0" />

                <TextBlock Text="Password" Margin="0,26,0,6" Style="{StaticResource BodyText}" />
                <PasswordBox x:Name="UnlockPasswordBox"
                             MaxWidth="360" HorizontalAlignment="Left" MinWidth="320"
                             PasswordChanged="OnUnlockPasswordChanged" />

                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding ErrorMessage}"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Unlock"
                            IsDefault="True"
                            Click="OnUnlockClick"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Back"
                            Margin="10,0,0,0"
                            Command="{Binding BackToWelcomeCommand}" />
                </StackPanel>

                <TextBlock Text="Deriving key..."
                           Style="{StaticResource SecondaryText}"
                           Margin="0,12,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Create -->
        <Grid Grid.Column="1" Margin="40,44,40,32"
              Visibility="{Binding Mode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Create}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Create a book" Style="{StaticResource PageTitleText}" />

                <TextBlock Text="Location" Margin="0,22,0,6" Style="{StaticResource BodyText}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SelectedPath, Mode=OneWay}"
                             IsReadOnly="True" MinWidth="320" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Browse..."
                            Margin="8,0,0,0"
                            Command="{Binding BrowseForNewLocationCommand}" />
                </StackPanel>

                <TextBlock Text="Password" Margin="0,18,0,6" Style="{StaticResource BodyText}" />
                <PasswordBox x:Name="CreatePasswordBox"
                             MinWidth="320" HorizontalAlignment="Left"
                             PasswordChanged="OnCreatePasswordChanged" />
                <TextBlock x:Name="StrengthText"
                           Style="{StaticResource SecondaryText}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="0,4,0,0" />

                <TextBlock Text="Confirm password" Margin="0,14,0,6" Style="{StaticResource BodyText}" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             MinWidth="320" HorizontalAlignment="Left" />

                <Border Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="4" Padding="12" Margin="0,18,0,0" MaxWidth="420"
                        HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="This password encrypts the book. There is no recovery — if you forget it, the data is gone. Back up both the .mfdb and .mfmeta files together." />
                </Border>

                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding ErrorMessage}"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Create"
                            Click="OnCreateClick" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Back"
                            Margin="10,0,0,0"
                            Command="{Binding BackToWelcomeCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
