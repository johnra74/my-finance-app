<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        A modern, restrained palette. Microsoft Money's information architecture is being
        kept; its 2007 blue gradients are not. Money figures use a single accent for
        positive and a single red for negative, and nothing else competes with them.
    -->

    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF6F7F9</Color>
    <Color x:Key="SurfaceSunkenColor">#FFEDEFF3</Color>
    <Color x:Key="BorderColor">#FFDDE1E7</Color>
    <Color x:Key="BorderStrongColor">#FFC3CAD3</Color>

    <Color x:Key="TextPrimaryColor">#FF1B1F24</Color>
    <Color x:Key="TextSecondaryColor">#FF5B6572</Color>
    <Color x:Key="TextInvertedColor">#FFFFFFFF</Color>

    <Color x:Key="AccentColor">#FF1F6FEB</Color>
    <Color x:Key="AccentHoverColor">#FF1A5FCC</Color>
    <Color x:Key="AccentSoftColor">#FFE8F1FE</Color>

    <Color x:Key="NavBarColor">#FF17324F</Color>
    <Color x:Key="NavBarHoverColor">#FF224566</Color>

    <Color x:Key="PositiveColor">#FF11734B</Color>
    <Color x:Key="NegativeColor">#FFC0392B</Color>
    <Color x:Key="WarningColor">#FFB26A00</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextInvertedBrush" Color="{StaticResource TextInvertedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="NavBarBrush" Color="{StaticResource NavBarColor}" />
    <SolidColorBrush x:Key="NavBarHoverBrush" Color="{StaticResource NavBarHoverColor}" />

    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!--
        Chart colours, taken from a validated data-visualization palette and checked against
        this application's own white chart surface rather than assumed. The two-series
        categorical pair passes every gate: worst adjacent separation ΔE 24.7 under
        protanopia, 33.6 for normal vision, both above 3:1 contrast on white.

        A magnitude bar chart uses ChartSeries1 for every bar. Colouring each bar
        darker-where-bigger would double-encode the length the bar already shows and spend
        the only free channel on nothing.
    -->
    <Color x:Key="ChartSeries1Color">#FF2A78D6</Color>
    <Color x:Key="ChartSeries2Color">#FFEB6834</Color>

    <SolidColorBrush x:Key="ChartSeries1Brush" Color="{StaticResource ChartSeries1Color}" />
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="{StaticResource ChartSeries2Color}" />

    <!-- Chart chrome stays recessive: the data is the ink, the frame is not. -->
    <SolidColorBrush x:Key="ChartGridBrush" Color="#FFE1E0D9" />
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#FFC3C2B7" />
    <SolidColorBrush x:Key="ChartMutedInkBrush" Color="#FF898781" />
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#FFEDEFF3" />

    <!--
        Status colours are reserved for state and never reused as a series. Warning sits
        below 3:1 on a white surface by design, so a status colour never carries meaning on
        its own — every use here is paired with a visible figure and a word.
    -->
    <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF0CA30C" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFFAB219" />
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FFD03B3B" />

    <!--
        Segoe UI Variable on Windows 11 falling back to Segoe UI. Tabular figures matter
        more than the face: a register column of amounts must align digit for digit.
    -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="NumericFontFamily">Segoe UI Variable Text, Segoe UI, Consolas</FontFamily>

    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>

</ResourceDictionary>
